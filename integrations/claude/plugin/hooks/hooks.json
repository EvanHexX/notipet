{
  "description": "notipet: ring when Claude needs you or finishes, and stop alarms that are over. Windows; needs the notipet app.",
  "hooks": {
    "Notification": [
      {
        "matcher": "agent_needs_input|agent_completed|permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "notipet.exe",
            "args": [
              "--source",
              "claude-code"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notipet.exe",
            "args": [
              "--source",
              "claude-code"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "notipet.exe",
            "args": [
              "--source",
              "claude-code"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notipet.exe",
            "args": [
              "--source",
              "claude-code"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
