<Application
    x:Class="Notipet.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Required, not optional. Without XamlControlsResources the WinUI control
         styles are never loaded, and the first window containing anything more
         involved than a TextBlock takes the whole process down with a stowed
         XAML exception (0xc000027b) that no managed handler can catch. The tray
         daemon had no windows until now, which is why this was missing. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
